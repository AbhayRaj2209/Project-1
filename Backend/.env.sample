# --- Required -------------------------------------------------------------
PORT=5000
MONGO_URI=
JWT_SECRET=
# JWT_EXPIRES_IN=1h

# --- URLs (no trailing slash). In production these MUST be your real deploy URLs
BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
# Comma-separated list of allowed frontend origins. Defaults to CLIENT_URL.
# Wildcards are allowed for preview deploys, e.g. https://*.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Google OAuth (optional — the button is disabled when unset) -----------
# Google Cloud Console > Credentials > OAuth client > Authorized redirect URIs
# must contain GOOGLE_CALLBACK_URL exactly (defaults to BACKEND_URL + path below).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- GitHub OAuth (optional — the button is disabled when unset) -----------
# GitHub > Settings > Developer settings > OAuth Apps. "Authorization callback URL"
# must equal GITHUB_CALLBACK_URL. One GitHub OAuth app supports one callback URL,
# so create separate apps for local and production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# --- Password reset email (Gmail app password) ------------------------------
EMAIL_USER=
EMAIL_PASS=
